@startuml

skinparam monochrome true
skinparam shadowing false

|Симулятор и календарь событий|
start
:Запуск модели;

|Источник|
:Для каждого источника вычислить interval
ИБ, ИЗ1: interval = -ln(U) / lambda;

|Симулятор и календарь событий|
:Поставить событие REQUEST_GENERATED
на время t + interval;

while (Календарь не пуст?) is (да)

  :Выдать ближайшее событие e
  Сдвинуть модельное время: currentTime = e.time;

  if (Тип события e?) then (REQUEST_GENERATED)

    |Источник|
    :Создать заявку r
    Заявка получает статус CREATED;

    |Симулятор и календарь событий|
    if (Сгенерировано меньше maxRequests?) then (да)
      |Источник|
      :Вычислить interval по ИЗ1;
      |Симулятор и календарь событий|
      :Поставить следующее событие REQUEST_GENERATED;
    else (нет)
      :Новые заявки больше не планируются;
    endif

    |Диспетчер постановки|
    :Принять заявку r
    Проверить заполненность буфера;

    if (Буфер полон?) then (нет)
      :Д1ОЗ1: найти первую свободную ячейку i
      по кольцу, начиная с указателя УБ
      Записать заявку r в ячейку i;
      :Сдвинуть указатель УБ = i + 1
      Вернуть null: отказа нет;
    else (да, ОТКАЗ)
      :Д1ОО3: найти самую старую заявку old
      с минимальным timeCreated, ячейка i;
      :Удалить old из буфера;
      :Заявка old получает статус REFUSED;
      :Записать новую заявку r в ячейку i;
      :Сдвинуть указатель УБ = i + 1
      Вернуть выбитую заявку old;
    endif

    |Симулятор и календарь событий|
    :Вызвать диспетчер выбора
    onBufferChanged;

  else (DEVICE_FINISHED)

    |Прибор|
    :Завершить обслуживание заявки r
    Заявка получает статус COMPLETED
    Прибор становится свободным;

    |Симулятор и календарь событий|
    :Вызвать диспетчер выбора
    onDeviceFreed;

  endif

  |Диспетчер выбора|
  while (Д2П2: буфер не пуст и найден свободный прибор по кольцу от УП?) is (да)
    :Д2Б3: найти ближайшую занятую ячейку slot
    по кольцу, начиная с указателя УВ;
    :Извлечь заявку r из ячейки slot;
    :Сдвинуть указатели: УВ = slot + 1, УП = d + 1
    Заявка r получает статус PROCESSING;
    |Прибор|
    :Начать обслуживание заявки r, прибор занят
    ПЗ1: duration = -ln(U) / mu;
    |Симулятор и календарь событий|
    :Поставить событие DEVICE_FINISHED
    на время t + duration;
    |Диспетчер выбора|
  endwhile (нет)

  if (Буфер пуст?) then (да)
    :Выбирать нечего, выдача закончена;
  else (нет)
    :Все приборы заняты, заявки ждут в буфере
    УВ и УП не меняются;
  endif

  |Симулятор и календарь событий|

endwhile (нет)

:Календарь пуст, модель завершена;

stop
@enduml
