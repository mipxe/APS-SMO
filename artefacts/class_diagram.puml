@startuml
title СМО «Сервис распределения заказов Яндекс Такси»\nВариант: ИБ ИЗ1 ПЗ1 Д1ОЗ1 Д1ОО3 Д2П2 Д2Б3 ОР2 ОД2

skinparam ClassAttributeIconSize 0
skinparam shadowing false

class Coordinate {
  +latitude: double
  +longitude: double
}

enum RequestStatus {
  CREATED
  PROCESSING
  COMPLETED
  REFUSED
}

class Request {
  -id: int
  -sourceId: int
  -timeCreated: double
  -timeStart: double
  -coorFrom: Coordinate
  -coorTo: Coordinate
  -status: RequestStatus
  +getId(): int
  +getSourceId(): int
  +getTimeCreated(): double
  +getTimeStart(): double
  +markProcessing(t: double)
  +markCompleted()
  +markRefused()
}

class Source {
  -id: int
  -lambda: double
  -requestCounter: int
  -calendar: EventCalendar
  +createRequest(t: double): Request
  +scheduleNext(t: double)
  -nextInterval(): double
}
note bottom of Source
  **ИБ, ИЗ1**: бесконечный источник, экспоненциальный закон.
  nextInterval() = -ln(U) / lambda.
end note

class Buffer {
  -slots: Request[]
  -capacity: int
  +getCapacity(): int
  +put(index: int, r: Request)
  +get(index: int): Request
  +remove(index: int): Request
  +isFull(): boolean
  +isEmpty(): boolean
  +snapshot(): Request[]
}

class Device {
  -id: int
  -mu: double
  -currentRequest: Request
  -calendar: EventCalendar
  +getId(): int
  +isBusy(): boolean
  +startService(r: Request, t: double)
  +finishService(t: double): Request
  -serviceTime(): double
}
note bottom of Device
  **ПЗ1**: время обслуживания экспоненциальное,
  serviceTime() = -ln(U) / mu.
end note

class PlacementDispatcher {
  -buffer: Buffer
  -bufferPointer: int
  +put(r: Request, t: double): Request
  +getBufferPointer(): int
  -findFreeSlotFromPointer(): int
  -findOldest(): int
}
note bottom of PlacementDispatcher
  **Д1ОЗ1**: первое свободное место по кольцу, начиная с УБ.
  **Д1ОО3**: если буфер полон, новая заявка встает на место 
  самой старой по времени создания.
end note

class SelectionDispatcher {
  -buffer: Buffer
  -devices: Device[]
  -selectPointer: int
  -devicePointer: int
  +onBufferChanged(t: double)
  +onDeviceFreed(t: double)
  +getSelectPointer(): int
  +getDevicePointer(): int
  -dispatch(t: double)
  -selectDevice(): Device
  -selectRequest(): Request
}
note bottom of SelectionDispatcher
  **Д2П2**: свободный прибор по кольцу от УП
  **Д2Б3**: ближайшая заявка по кольцу от УВ
end note

enum EventType {
  REQUEST_GENERATED
  DEVICE_FINISHED
}

class Event {
  -time: double
  -type: EventType
  -source: Source
  -device: Device
  +getTime(): double
  +getType(): EventType
  +getSource(): Source
  +getDevice(): Device
}

class EventCalendar {
  -events: PriorityQueue<Event>
  +schedule(e: Event)
  +next(): Event
  +isEmpty(): boolean
  +snapshot(): Event[]
}

class Simulation {
  -sources: Source[]
  -devices: Device[]
  -buffer: Buffer
  -calendar: EventCalendar
  -placeDisp: PlacementDispatcher
  -selectDisp: SelectionDispatcher
  -statistic: Statistic
  -currentTime: double
  -maxRequests: int
  +step(): StepRecord
  +runAuto(): SummaryTable
  +isFinished(): boolean
  +getCurrentTime(): double
  -onRequestGenerated(e: Event)
  -onDeviceFinished(e: Event)
}

class Statistic {
  -generated: int[]
  -rejected: int[]
  -processed: int[]
  -waitSum: double[]
  -waitSqSum: double[]
  -serviceSum: double[]
  -serviceSqSum: double[]
  -deviceBusyTime: double[]
  +recordGenerated(r: Request)
  +recordRejected(r: Request)
  +recordServiceFinish(r: Request, deviceId: int, t: double)
  +getSummaryTable(tEnd: double): SummaryTable
}

class StepRecord <<ОД2>> {
  +time: double
  +event: Event
  +calendar: Event[]
  +buffer: Request[]
  +bufferPointer: int
  +selectPointer: int
  +devicePointer: int
  +deviceStates: String[]
  +totalGenerated: int
  +totalRejected: int
}

class SummaryTable <<ОР2>> {
  +generated: int[]
  +rejectProbability: double[]
  +avgSystem: double[]
  +avgWait: double[]
  +avgService: double[]
  +waitVariance: double[]
  +serviceVariance: double[]
  +deviceLoad: double[]
}

Simulation *-- "1..*" Source
Simulation *-- "1..*" Device
Simulation *-- Buffer
Simulation *-- EventCalendar
Simulation *-- PlacementDispatcher
Simulation *-- SelectionDispatcher
Simulation *-- Statistic
Simulation ..> StepRecord
Simulation ..> SummaryTable

EventCalendar o-- "0..*" Event
Event --> EventType
Event --> "0..1" Source
Event --> "0..1" Device
Source --> EventCalendar
Device --> EventCalendar

Source ..> Request : creates
Request --> RequestStatus
Request --> "2" Coordinate
Buffer o-- "0..*" Request
Device --> "0..1" Request

PlacementDispatcher --> Buffer
SelectionDispatcher --> Buffer
SelectionDispatcher --> "1..*" Device

Statistic ..> SummaryTable
StepRecord --> "0..1" Event
StepRecord o-- "0..*" Request

@enduml
